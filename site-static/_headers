# Generated by marketing/build-seo-site.mjs (renderHeaders in render.mjs). Cloudflare Pages only.
# assemble-pages-site.mjs merges these rules into the web app's _headers.
# /app/auth/confirm* covers the exported route and confirm.html, including the token query.
/app/auth/confirm*
  Referrer-Policy: no-referrer

# The web app is for signed-in students: keep it out of search results.
/app/*
  X-Robots-Tag: noindex

# Copies of the site on pages.dev (production alias, branch previews, per-deploy URLs).
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# Versioned URLs (?v=<content hash>, see assets.mjs): safe to cache for a year.
/mg.css
  Cache-Control: public, max-age=31536000, immutable

/mg.js
  Cache-Control: public, max-age=31536000, immutable

/marketing.css
  Cache-Control: public, max-age=31536000, immutable

/motion.css
  Cache-Control: public, max-age=31536000, immutable

/practice.css
  Cache-Control: public, max-age=31536000, immutable

/practice.js
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
